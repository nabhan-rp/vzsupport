{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vz-support-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-11-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "support.vz.gay",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "SUPPORT_DB",
      "database_name": "vz_support_db",
      "database_id": "59ad3174-7548-4004-a92c-bf71ebae2ebe"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "nabhanrp.cloudflareaccess.com",
    "ACCESS_AUD": "bc0f3073dde5c4f590cf8aa9ada64807a2e05022f8e01da3e6c113b2f1f3cf8b",
    "PUBLIC_FORM_ORIGINS": "https://vz.gay,https://www.vz.gay",
    "TURNSTILE_EXPECTED_HOSTNAMES": "vz.gay,www.vz.gay"
  }
}
